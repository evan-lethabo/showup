# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Required. Neon Postgres connection string (use the pooled one). Create the tables with `npm run db:setup`.
DATABASE_URL=

# Optional. OpenAI API key used to interpret guests' "it depends on..." conditions.
# If it is not set, the app uses a built-in offline parser and labels the result as such.
OPENAI_API_KEY=

# Optional. Overrides the OpenAI model used for condition interpretation (the default is set in lib/server/openai.ts).
OPENAI_INTERPRETER_MODEL=
